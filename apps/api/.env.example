NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://solvify:solvify@localhost:5432/solvify?schema=public

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-long-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=

PUBLIC_BASE_URL=http://localhost:4000
PLATFORM_CURRENCY=NGN

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_IMAGE_MB=5
MAX_DOC_MB=10

SEARCH_LOCATION_SCOPE=city

# Ranking weights — must sum to 1.0
RANK_W_SERVICE=0.30
RANK_W_LOCATION=0.25
RANK_W_VERIFICATION=0.15
RANK_W_RATING=0.10
RANK_W_REVIEWS=0.05
RANK_W_EXPERIENCE=0.05
RANK_W_COMPLETED=0.05
RANK_W_AVAILABILITY=0.05

MAIL_DRIVER=console